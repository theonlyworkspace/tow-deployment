map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

# In this TLS_MODE=off layout an edge proxy in front of this server usually
# terminates TLS. Pass its X-Forwarded-Proto=https through so the backend and
# authentik see the original scheme (authentik derives the OIDC issuer from
# it); fall back to this server's own scheme otherwise.
map $http_x_forwarded_proto $tow_forwarded_proto {
    default $scheme;
    https https;
}

server {
    listen 80;
    server_name ${PUBLIC_HOST};
    client_max_body_size ${PROXY_CLIENT_MAX_BODY_SIZE};
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_vary on;
    gzip_types application/javascript application/json application/xml image/svg+xml text/css text/plain text/xml;

    include /tmp/tow-nginx-rendered/locations.conf;
}

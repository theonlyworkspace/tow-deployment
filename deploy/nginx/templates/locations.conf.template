resolver 127.0.0.11 valid=10s ipv6=off;
resolver_timeout 5s;

# Keep upstream responses intact, including application-generated 502/504
# responses. The error_page below is therefore used only for errors nginx
# generates while it is unable to reach an upstream.
proxy_intercept_errors off;
error_page 502 504 =503 /_tow_maintenance.html;

location = /_tow_maintenance.html {
    internal;
    alias /etc/nginx/launch/maintenance.html;
    default_type text/html;
    charset utf-8;
    add_header Cache-Control "no-store" always;
    add_header Retry-After "30" always;
}

# Variables defer service-name resolution until request time. This lets nginx
# stay available while Compose replaces or temporarily removes app containers.
set $tow_backend_upstream http://backend:8000;
set $tow_frontend_upstream http://frontend:3000;

location = /__tow_proxy_health {
    allow 127.0.0.1;
    allow ::1;
    deny all;
    access_log off;
    default_type text/plain;
    alias /etc/nginx/launch/health.txt;
}

location ^~ /api/socket.io {
    proxy_pass $tow_backend_upstream;
    include /etc/nginx/launch/proxy-headers.conf;
    proxy_buffering off;
}

location = /api/mcp {
    proxy_pass $tow_backend_upstream;
    proxy_http_version 1.1;
    proxy_set_header Authorization $http_authorization;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port $server_port;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_cache off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 300s;
    client_max_body_size 256k;
}

location ^~ /api/ {
    proxy_pass $tow_backend_upstream;
    include /etc/nginx/launch/proxy-headers.conf;
}

include /tmp/tow-nginx-rendered/authentik-location.conf;

location / {
    proxy_pass $tow_frontend_upstream;
    include /etc/nginx/launch/proxy-headers.conf;
}
